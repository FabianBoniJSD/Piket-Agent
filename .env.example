# Twilio Konfiguration (erforderlich für Telefonanrufe)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+41xxxxxxxxx

# Backend URL (für Twilio Webhooks - ngrok URL in lokaler Entwicklung)
# Beispiel: BASE_URL=https://abc123.ngrok.io
BASE_URL=http://localhost:8000

# CORS Origins (Frontend URL)
CORS_ORIGINS=http://localhost:3000

# Datenbank (SQLite für lokale Entwicklung, PostgreSQL für Produktion)
# SQLite:
DATABASE_URL=sqlite:///./piket.db
# PostgreSQL Beispiel:
# DATABASE_URL=postgresql://user:password@localhost:5432/piket_db
